{
  "name": "pi-cockpit-hud",
  "version": "0.1.0",
  "description": "A futuristic flight-deck HUD and telemetry overlay for the pi coding agent.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cockpit",
    "hud",
    "telemetry"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cockpit/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "pi -e ./extensions/cockpit",
    "dev:isolated": "pi -ne -e ./extensions/cockpit"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
