{
  "name": "pi-cockpit-hud",
  "version": "0.1.2",
  "description": "Flight-deck HUD and telemetry deck for pi: live context pressure, token throughput, cost and tool activity, mounted above the editor.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "cockpit",
    "hud",
    "telemetry",
    "tui",
    "observability",
    "context-usage",
    "tokens"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cockpit/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/steelburn/pi-cockpit-hud/main/docs/preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "pi -e ./extensions/cockpit",
    "dev:isolated": "pi -ne -e ./extensions/cockpit"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steelburn/pi-cockpit-hud.git"
  },
  "homepage": "https://github.com/steelburn/pi-cockpit-hud#readme",
  "bugs": {
    "url": "https://github.com/steelburn/pi-cockpit-hud/issues"
  }
}
